// FizzBuzz, edición Reino Champiñón: los múltiplos de 3 son de Mario, los de 5 de Luigi, los de ambos, de los hermanos.
world 1-1 {
  run n from 1 to 15 {
    question n % 15 == 0 {
      wahoo("¡Mario y Luigi!")
    } else question n % 3 == 0 {
      wahoo("Mario")
    } else question n % 5 == 0 {
      wahoo("Luigi")
    } else {
      wahoo(n)
    }
  }
}
